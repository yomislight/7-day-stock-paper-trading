# Binance credentials stay local. Do not paste secrets into chat.
# Legacy template only. Use 10-API密钥-仅本地-local-secrets/binance-api.env instead; the checker does not read .env.

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Stock/ETF experiment switches. Keep false until verified.
BINANCE_STOCKS_ENABLED=false
BINANCE_PAPER_TRADING_AVAILABLE=false

# Safety defaults.
PAPER_TRADING_ONLY=true
LIVE_TRADING_ENABLED=false
HUMAN_CONFIRMATION_REQUIRED_FOR_LIVE_ORDERS=true

# Supplemental five-minute bars are retrieved from a keyless public chart source.
# No additional market-data credential belongs in this file.
