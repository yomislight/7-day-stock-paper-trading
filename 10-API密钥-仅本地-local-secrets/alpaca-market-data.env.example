# Copy this file to alpaca-market-data.env and fill it locally.
# Legacy optional template. The active runtime does not read this file.
# Do not open an unsupported brokerage account or provide false residency information.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_SYMBOLS=SPY,QQQ,DIA,IWM,AAPL,NVDA,XOM,JPM
ALPACA_MAX_AGE_SECONDS=300
